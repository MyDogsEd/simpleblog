<div class="card mb-4">  
  <div class="card-header">
    <h5 class="card-title">{{title}}</h5>
    <p class="text-secondary">{{author}}</p>
  </div>
  <div class="card-body">
    <p class="card-text">
      {{content}}
    </p>
    <a href="posts/{{id}}" class="btn btn-primary">View Post</a>
  </div>
  <div class="card-footer text-muted">
    Posted on January 1, 2024
  </div>
</div>